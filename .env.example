# Environment variables read by trip_with_me/settings.py.
# The app does not load this file by itself: export the variables in your
# shell (e.g. `set -a; source .env; set +a`) or rely on the local defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=trip_maker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
